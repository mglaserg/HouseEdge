# Base RPC is now used for lightweight/state reads and timestamp->block resolution.
# A private keyed endpoint is recommended; Alchemy Free is fine for these calls.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Required for bulk historical Base logs in HouseEdge v0.2.0.
# Create a free/development Envio token and keep it local; never commit it.
ENVIO_API_TOKEN=YOUR_ENVIO_API_TOKEN
